    "periods": [
      "2024-01",
      "2024-02"
    ],
    "matching": "Exact item-key equality. Shared rows use lowercase ASCII item keys, positive finite unit prices, one currency per persona, pack_size 1, and only recurring/one_off consumption.",
    "price_formula": "For each period and item, quantity-weighted mean unit_price; then 100 times the equal-weight mean of current/base price relatives over base-period items that match.",
    "expenditure_formula": "100 times the sum of absolute paid_total in the current period divided by the same sum in the base period. This is expenditure change, not a price index.",
    "coverage_formula": "100 times matched base-period item count divided by the base-period item count.",
    "rounding": {
      "price_index_decimal_places": 6,
      "expenditure_index_decimal_places": 6,
      "coverage_decimal_places": 2,
      "comparison_absolute_tolerance": 0.000001
    },
    "included_columns": "All 25 canonical receipt columns are included in every fixture row. In these cases pack_size is 1, discount/fee/tax/deposit are 0, expenses have negative paid_total, ratings are 1-5, tiers are A-E, and availability is in_stock."
